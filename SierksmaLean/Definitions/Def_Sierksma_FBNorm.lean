def kpred (k r2 x : Nat) : Bool :=
  !(Nat.beq x (R1.getD k 0)) && !(Nat.beq x r2) &&
    (!(Nat.testBit (intt 36) x) || (Nat.ble (L1t (R1.getD k 0)) (L1t x) && Nat.ble (L2t k r2) (L2t k x)))

def Kbuild (P : Nat → Bool) : Nat :=
  Nat.rec (motive := fun _ => Nat) 0 (fun x acc => Nat.lor acc (cond (P x) (Nat.shiftLeft 1 x) 0)) 1855

def KS (k r2 : Nat) : Nat := Kbuild (kpred k r2)

